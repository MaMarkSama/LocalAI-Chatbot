# ── Line API ──────────────────────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here

# ── Ollama ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=your_ollama_api_key_or_bearer_token_here
OLLAMA_MODEL=gemma3:9b
OLLAMA_VISION_MODEL=gemma3:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=32768
OLLAMA_MAX_RESPONSE_TOKENS=-1
OLLAMA_WARMUP_ENABLED=1
CONVERSATION_MAX_TURNS=100

# ── ngrok Static Domain (optional) ────────────────────────────────────────
# NGROK_DOMAIN=your-domain.ngrok-free.app

# ── Web Chat ──────────────────────────────────────────────────────────────
WEB_PORT=8001

# ── Auth / Security ───────────────────────────────────────────────────────
# JWT_SECRET จะถูกสุ่มอัตโนมัติถ้าไม่ได้ตั้ง
# JWT_SECRET=your_random_secret_here
TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=0
TRUSTED_PROXIES=127.0.0.1,::1
CSP_STRICT=0
MAX_DECOMPRESSED_BYTES=52428800
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=20

# ── System Prompt ──────────────────────────────────────────────────────────
SYSTEM_PROMPT="คุณคือผู้ช่วย AI ที่ฉลาดและเป็นมิตร ตอบคำถามภาษาไทยได้อย่างชัดเจน กระชับ และเป็นประโยชน์\n- จัดโครงสร้างคำตอบให้อ่านง่ายและสวยงาม โดยใช้หัวข้อ (Headings), รายการแบบจุด (Bullet points), ตัวหนาเน้นคำสำคัญ และใช้ตารางเมื่อเปรียบเทียบข้อมูล\n- หากมีการใส่ลิงก์ ให้ใช้ข้อความสั้นกระชับเสมอ เช่น [ชื่อสั้นกระชับ](URL) ห้ามใส่ URL ดิบยาวเหยียดในเนื้อหา\n- เมื่อเขียนโค้ด ให้ระบุภาษาหลัง ``` เสมอ เช่น ```python\n- หากไม่แน่ใจข้อมูลใด ให้บอกตรง ๆ"

# ── File Processing ────────────────────────────────────────────────────────
PDF_MAX_CHARS=20000
MAX_UPLOAD_BYTES=26214400
MAX_TABLE_ROWS=5000

# MessageTurboVec / Document retrieval
TURBOVEC_ENABLED=1
TURBOVEC_MIN_CHARS=5000
TURBOVEC_CHUNK_CHARS=1200
TURBOVEC_TOP_K=6

# ── Runtime paths ──────────────────────────────────────────────────────────
DB_PATH=data/chat_history.db
APP_BACKUP_DIR=backups
APP_LOG_DIR=logs

# ── Agent-style Web Research ──────────────────────────────────────────────
SEARCH_QUERY_PLANNER=1
SEARCH_MAX_QUERIES=3
SEARCH_MAX_RESULTS=8
SEARCH_FETCH_PAGES=5
SEARCH_MAX_EXCERPT_CHARS=3500
SEARCH_MAX_CONTEXT_CHARS=18000
SEARCH_REGION=th-th
SEARCH_SAFESEARCH=moderate
SEARCH_CACHE_TTL_SECONDS=300
SEARCH_CACHE_MAX_ENTRIES=128
